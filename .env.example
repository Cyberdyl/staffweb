# ============================================================
#  Configuration Supabase (valeurs PUBLIQUES — sûres à exposer)
#  La sécurité réelle est assurée par les règles RLS de Supabase.
# ============================================================

# URL de ton projet Supabase  (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé "anon public"  (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJ...

# Nom affiché du serveur / communauté (personnalisable)
VITE_SERVER_NAME=BlueStark
